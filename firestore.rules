rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    // ---- public profile basics (no email, no private details) ----
    match /users/{uid} {
      allow read: if true;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['username','usernameLower','displayName','createdAt','publicProfile','showActivity','leaderboardOptOut'])
        && request.resource.data.username is string && request.resource.data.username.matches('^[a-zA-Z0-9_]{3,20}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower));
      allow update: if owner(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['username','usernameLower','displayName','createdAt','publicProfile','showActivity','leaderboardOptOut'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40;
      allow delete: if owner(uid);
    }
    // bio / social links are readable only when the profile is public (or by the owner)
    match /profileDetails/{uid} {
      allow read: if owner(uid) || get(/databases/$(database)/documents/users/$(uid)).data.publicProfile == true;
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['bio','social','keyboard'])
        && request.resource.data.get('bio','').size() <= 300;
    }
    // username -> uid, for uniqueness
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- results ----
    match /results/{id} {
      allow read: if resource.data.public == true || owner(resource.data.userId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.username == me().username
        && request.resource.data.createdAt == request.time
        && request.resource.data.mode in ['time','words','quote','zen','custom']
        && request.resource.data.wpm is number && request.resource.data.wpm >= 0 && request.resource.data.wpm <= 350
        && request.resource.data.rawWpm is number && request.resource.data.rawWpm >= 0 && request.resource.data.rawWpm <= 400
        && request.resource.data.accuracy is number && request.resource.data.accuracy >= 0 && request.resource.data.accuracy <= 100
        && request.resource.data.duration is number && request.resource.data.duration >= 1 && request.resource.data.duration <= 3700
        && request.resource.data.rawWpm + 1 >= request.resource.data.wpm
        // wpm can never exceed what the reported number of typed characters allows
        && request.resource.data.wpm <= request.resource.data.typedChars / 5.0 / (request.resource.data.duration / 60.0) + 1
        && request.resource.data.correctChars is int && request.resource.data.typedChars is int
        && request.resource.data.typedChars <= request.resource.data.duration * 40 + 5
        && request.resource.data.validationStatus in ['valid','flagged','experimental','unranked']
        // ranked results must come from a 15s+ real test with no flags
        && (request.resource.data.validationStatus != 'valid' || (request.resource.data.duration >= 5 && request.resource.data.flags.size() == 0 && request.resource.data.funbox == 'none'));
      allow update: if owner(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags','personalBest']);
      allow delete: if owner(resource.data.userId);
    }
    match /resultEvents/{id} {
      allow read: if owner(resource.data.userId);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.data.size() < 600000;
      allow delete: if owner(resource.data.userId);
      allow update: if false;
    }

    // ---- private per-user data ----
    match /userSettings/{uid} {
      allow read, write: if owner(uid) && request.resource.data.keys().hasOnly(['blob','updatedAt']) && request.resource.data.blob.size() < 400000;
    }

    // ---- friends: one document per pair, id = sortedUid1_sortedUid2 ----
    match /friends/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.auth.uid in request.resource.data.users && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && pairId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && ((request.resource.data.status == 'pending' && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId != request.auth.uid)
            || (request.resource.data.status == 'blocked' && request.resource.data.blockerId == request.auth.uid));
      allow update: if signedIn() && resource.data.status == 'pending' && resource.data.receiverId == request.auth.uid
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.users
        && (resource.data.status != 'blocked' || resource.data.blockerId == request.auth.uid);
    }

    // ---- notifications ----
    match /notifications/{id} {
      allow read: if owner(resource.data.userId);
      allow create: if signedIn() && request.resource.data.fromId == request.auth.uid && request.resource.data.userId != request.auth.uid
        && request.resource.data.type in ['friend-request','friend-accepted'] && request.resource.data.isRead == false;
      allow update: if owner(resource.data.userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if owner(resource.data.userId);
    }

    // ---- quotes ----
    match /quotes/{id} { allow read: if resource.data.approvalStatus == 'approved'; allow write: if false; }   // moderators add via the Firebase console
    match /quoteSubmissions/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.text.size() >= 20 && request.resource.data.text.size() <= 600;
      allow read, update, delete: if false;
    }
    match /quoteRatings/{id} {
      allow create, update: if signedIn() && id == request.resource.data.quoteId + '_' + request.auth.uid && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating in [1,2,3,4,5];
      allow read: if owner(resource.data.userId);
    }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.kind in ['quote','user'] && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
